# Режим развёртывания: local | public
APP_MODE=local
PORT=3000
APP_URL=http://localhost:3000

# Доступ администратора (в продакшене задайте ADMIN_PASSWORD_HASH или ADMIN_PASSWORD)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Секретные ключи подписи и шифрования настроек (AES-256-GCM)
# Если не заданы, генерируются автоматически или берутся из локального ключа в data/
JWT_SECRET=
MASTER_KEY=

# Единый OpenAI-совместимый шлюз с оплатой в рублях
LLM_BASE_URL=
LLM_API_KEY=

# Модели агентов (задаются в .env или через интерфейс настроек)
CODER_MODEL=
ARCHITECT_MODEL=
REVIEWER_MODEL=

# Бюджет и экономия
DEFAULT_PROJECT_BUDGET_RUB=50
DAILY_BUDGET_RUB=300
SKIP_REVIEW=false
ALLOW_CODER_FALLBACK=false

# Режим выполнения сборок: docker | process
RUNNER_MODE=process
RUNNER_INSTALL_URL=http://runner-install:4001
RUNNER_EXEC_URL=http://runner-exec:4002

# Каталог данных и рабочих проектов
DATA_DIR=./data
WORK_DIR=./work
TEMPLATES_DIR=./templates

# Публичный домен для профиля public (Caddyfile)
PUBLIC_DOMAIN=localhost

